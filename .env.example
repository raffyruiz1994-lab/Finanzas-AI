# ==========================================
# FINANZAS AI - FRONTEND ENVIRONMENT VARIABLES
# ==========================================

# URL del Backend API (En desarrollo web: http://localhost:3001/api, en móvil: http://<TU_IP_LAN>:3001/api)
EXPO_PUBLIC_API_URL=http://localhost:3001/api

# ------------------------------------------
# GOOGLE CLOUD OAUTH CLIENT IDS
# ------------------------------------------
# Client ID para Web (Registrado con Authorized JavaScript Origins http://localhost:8081)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Client ID para iOS nativo
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com

# Client ID para Android nativo
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com

# ------------------------------------------
# APPLE SIGN IN CLIENT ID / SERVICE ID
# ------------------------------------------
EXPO_PUBLIC_APPLE_CLIENT_ID=com.finanzasai.app
