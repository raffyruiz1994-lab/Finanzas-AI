# ==========================================
# FINANZAS AI - BACKEND ENVIRONMENT VARIABLES
# ==========================================

# Puerto del servidor backend Express
PORT=3001

# Entorno: development | production
NODE_ENV=development

# Clave secreta para firmar tokens JWT (Cambiar por una cadena aleatoria segura en producción)
JWT_SECRET=finanzas_ai_super_secret_jwt_key_2026_dev_mode

# ------------------------------------------
# GOOGLE CLOUD OAUTH CONFIGURATION
# ------------------------------------------
# Client ID de Google Cloud Console (OAuth 2.0 Client IDs -> Web application)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Client Secret (si se requiere intercambio de Authorization Code)
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------
# APPLE DEVELOPER SIGN IN WITH APPLE
# ------------------------------------------
# Service ID o Bundle ID registrado en Apple Developer (ej. com.finanzasai.app o com.finanzasai.service)
APPLE_CLIENT_ID=com.finanzasai.app
# Team ID de 10 caracteres de tu cuenta de Apple Developer
APPLE_TEAM_ID=XXXXXXXXXX
# Key ID de la clave privada creada para Sign in with Apple
APPLE_KEY_ID=XXXXXXXXXX
# Clave privada .p8 descargada de Apple Developer (escapando saltos de línea con \n)
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
